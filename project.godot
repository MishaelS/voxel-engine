; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Voxel Engine Godot Edition"
config/version="0.1.1-beta"
run/main_scene="uid://6r4lkmcwjoy"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Voxel Engine"
config/features=PackedStringArray("4.5", "Forward Plus")
boot_splash/bg_color=Color(0.11, 0.086, 0.07, 1)
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="res://assets/textures/extra/boot_splash.png"
config/icon="res://icon.svg"
config/developer="MishaelS"

[autoload]

WindowControls="*res://scripts/window_controls.gd"
TickLoop="*res://scripts/core/tick_loop.gd"
Settings="*res://scripts/settings/settings.gd"
ShaderPacks="*res://scripts/render/shader_packs.gd"
Sounds="*res://scripts/core/sounds.gd"
Net="*res://scripts/net/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/vsync/vsync_mode=0

